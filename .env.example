# Bu dosyayı ".env" adıyla kopyalayın ve anahtarınızı yapıştırın.
# Ücretsiz Gemini anahtarı: https://aistudio.google.com/apikey  (Google hesabıyla giriş -> "Create API key")
# Anahtar boş bırakılırsa uygulama DEMO modunda çalışır (yapay zekâ yerine taklit sonuçlar).
EXPO_PUBLIC_GEMINI_API_KEY=

# İsteğe bağlı: kullanılacak model. "gemini-flash-latest" her zaman güncel ücretsiz Flash modelini gösterir.
EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-latest

# Groq (ücretsiz, hızlı, görsel okuyabilir) — ÖNERİLEN. Anahtar: https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=
# İsteğe bağlı: belirli bir Groq modeli zorlamak için (boşsa otomatik seçilir)
EXPO_PUBLIC_GROQ_MODEL=

# İlan sunucusu adresi (server/ klasörü, sunucu.bat ile başlar). Telefondan denerken localhost yerine
# bilgisayarın yerel IP'sini yazın (örn. http://192.168.1.35:3001).
EXPO_PUBLIC_API_URL=http://localhost:3001
